    },
    {
      "path": "examples/valid/task_request_correlate.json",
      "kind": "message",
      "description": "A correlate task that points at findings by id (references)",
      "expected_verdict": "accepted",
      "expected_code": null
    },
    {
      "path": "examples/valid/finding_with_not_assessable.json",
      "kind": "message",
      "description": "A finding with an assessed observation, a status-unknown observation (not assessable, no value) and a hypothesis citing evidence",
      "expected_verdict": "accepted",
      "expected_code": null
    },
    {
      "path": "examples/valid/clarification_request.json",
      "kind": "message",
      "description": "The correlation agent asks a question",
      "expected_verdict": "accepted",
      "expected_code": null
    },
    {
      "path": "examples/valid/clarification_response_answered.json",
      "kind": "message",
      "description": "A clarification answered with a new observation",
      "expected_verdict": "accepted",
      "expected_code": null
    },
    {
      "path": "examples/valid/clarification_response_unanswered.json",
      "kind": "message",
      "description": "A clarification the target cannot answer",
      "expected_verdict": "accepted",
      "expected_code": null
    },
    {
      "path": "examples/valid/decision_diagnosed.json",
      "kind": "message",
      "description": "A diagnosed decision (heuristic score, no abstention block)",
      "expected_verdict": "accepted",
      "expected_code": null
    },
    {
      "path": "examples/valid/decision_with_abstention.json",
      "kind": "message",
      "description": "An insufficient_evidence decision explaining why it abstains",
      "expected_verdict": "accepted",
      "expected_code": null
    },
    {
      "path": "examples/valid/report_ready_with_recommendation.json",
      "kind": "message",
