      },
      "title": "Supporting Evidence",
      "type": "array"
    },
    "suspected_root_cause": {
      "title": "Suspected Root Cause",
      "type": "string"
    }
  },
  "required": [
    "incident_id",
    "status",
    "suspected_root_cause",
    "confidence",
    "affected_devices",
    "supporting_evidence",
    "alternative_causes",
    "recommended_actions",
    "evidence_sources",
    "limitations"
