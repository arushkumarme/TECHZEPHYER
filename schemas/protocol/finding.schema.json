{
  "$defs": {
    "Hypothesis": {
      "description": "An agent-local interpretation; never a fact and never the final confidence.",
      "properties": {
        "cause_type": {
          "enum": [
            "normal_operation",
            "link_congestion",
            "upstream_congestion",
            "weak_wifi",
            "interface_fault",
            "device_overload",
            "device_failure",
            "dns_dhcp_failure",
            "telemetry_unreliable"
          ],
          "title": "Cause Type",
          "type": "string"
        },
        "contradicting_observation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Contradicting Observation Ids",
          "type": "array"
        },
        "entities": {
          "items": {
            "type": "string"
          },
          "title": "Entities",
          "type": "array"
        },
        "hypothesis_id": {
          "title": "Hypothesis Id",
          "type": "string"
        },
        "local_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Local Score",
          "type": "number"
        },
        "missing_expected_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Expected Evidence",
          "type": "array"
        },
        "rationale_code": {
          "title": "Rationale Code",
          "type": "string"
        },
        "supporting_observation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Observation Ids",
          "type": "array"
        }
      },
      "required": [
        "hypothesis_id",
        "cause_type",
        "entities",
        "local_score",
        "rationale_code"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "Limitation": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "code",
        "text"
      ],
      "title": "Limitation",
      "type": "object"
    },
    "NotAssessableItem": {
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "reason": {
          "enum": [
            "MISSING",
            "MALFORMED",
            "UNMAPPED_FIELD",
            "UNIT_AMBIGUOUS",
            "STALE",
            "INSUFFICIENT_SAMPLES",
            "NO_TOPOLOGY",
            "OUT_OF_SCOPE",
            "IMPLAUSIBLE"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "entity",
        "metric",
        "reason"
      ],
      "title": "NotAssessableItem",
      "type": "object"
    },
    "Observation": {
      "description": "A measured or derived fact about one entity and one metric.",
      "properties": {
        "agent": {
          "enum": [
            "orchestrator",
            "performance_agent",
            "infrastructure_agent",
            "connectivity_agent",
            "correlation_agent",
            "reporting_agent",
            "community_module"
          ],
          "title": "Agent",
          "type": "string"
        },
        "assessability": {
          "enum": [
            "assessed",
            "assessed_with_caveat",
            "not_assessable"
          ],
          "title": "Assessability",
          "type": "string"
        },
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "evidence_class": {
          "default": "direct_measurement",
          "enum": [
            "direct_measurement",
            "derived",
            "user_report"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "metric": {
          "description": "Canonical metric name (doc 06), e.g. 'latency_ms'",
          "title": "Metric",
          "type": "string"
        },
        "metric_category": {
          "title": "Metric Category",
          "type": "string"
        },
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "quality_flags": {
          "items": {
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "severity": {
          "enum": [
            "normal",
            "elevated",
            "critical",
            "unknown"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_ref": {
          "description": "Normalized record IDs",
          "items": {
            "type": "string"
          },
          "title": "Source Ref",
          "type": "array"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "window": {
          "$ref": "#/$defs/TimeWindow"
        }
      },
      "required": [
        "observation_id",
        "entity",
        "metric",
        "metric_category",
        "value",
        "unit",
        "window",
        "severity",
        "assessability",
        "agent"
      ],
      "title": "Observation",
      "type": "object"
    },
    "SelfAssessment": {
      "properties": {
        "assessed_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Assessed Fraction",
          "type": "number"
        },
        "budget_exhausted": {
          "title": "Budget Exhausted",
          "type": "boolean"
        }
      },
      "required": [
        "assessed_fraction",
        "budget_exhausted"
      ],
      "title": "SelfAssessment",
      "type": "object"
    },
    "TimeWindow": {
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    },
    "ToolCallRecord": {
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "result_summary": {
          "title": "Result Summary",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "result_summary",
        "at"
      ],
      "title": "ToolCallRecord",
      "type": "object"
    }
  },
  "properties": {
    "facts": {
      "additionalProperties": true,
      "description": "Structured non-metric facts, e.g. topology scope from connectivity_agent",
      "title": "Facts",
      "type": "object"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "limitations": {
      "items": {
        "$ref": "#/$defs/Limitation"
      },
      "title": "Limitations",
      "type": "array"
    },
    "not_assessable": {
      "items": {
        "$ref": "#/$defs/NotAssessableItem"
      },
      "title": "Not Assessable",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Observations",
      "type": "array"
    },
    "self_assessment": {
      "$ref": "#/$defs/SelfAssessment"
    },
    "tool_calls": {
      "items": {
        "$ref": "#/$defs/ToolCallRecord"
      },
      "title": "Tool Calls",
      "type": "array"
    }
  },
  "required": [
    "observations",
    "self_assessment"
  ],
  "title": "Finding",
  "type": "object"
}
